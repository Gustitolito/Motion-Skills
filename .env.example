# .env.example — Modelo de Variáveis de Ambiente do Motion Design Studio
# Copie este arquivo para .env ou .env.local para configurar seu ambiente local.
# NUNCA versione arquivos .env contendo chaves ou segredos reais.

# Configurações de Concorrência e Render (Opcional)
# REMOTION_CONCURRENCY=

# Chaves de API para Produções Automatizadas (Opcional)
# Descomente e preencha localmente caso utilize serviços externos em seus projetos:
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
